{
  "name": "@fluxstack/live-elysia",
  "version": "0.6.1",
  "description": "Elysia.js WebSocket transport adapter for @fluxstack/live (Bun runtime)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluxstack/live": "^0.6.0"
  },
  "peerDependencies": {
    "elysia": ">=1.0.0"
  },
  "devDependencies": {
    "elysia": "^1.4.6",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FluxStackCore/fluxstack-live",
    "directory": "packages/elysia"
  },
  "license": "MIT",
  "keywords": ["elysia", "bun", "websocket", "transport", "live-components", "fluxstack"],
  "engines": {
    "node": ">=18.0.0"
  }
}
