{
  "name": "@fluxstack/live-react",
  "version": "0.7.1",
  "description": "React hooks and providers for @fluxstack/live — Live.use(), $field(), LiveComponentsProvider",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluxstack/live": "^0.7.0",
    "@fluxstack/live-client": "^0.7.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "zustand": ">=4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.1.0",
    "zustand": "^5.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FluxStackCore/fluxstack-live",
    "directory": "packages/react"
  },
  "license": "MIT",
  "keywords": ["react", "hooks", "realtime", "websocket", "live-components", "fluxstack"],
  "engines": {
    "node": ">=18.0.0"
  }
}
