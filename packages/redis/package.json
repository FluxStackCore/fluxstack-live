{
  "name": "@fluxstack/live-redis",
  "version": "0.7.0",
  "description": "Redis adapters for @fluxstack/live — cluster singleton coordination, action forwarding, failover recovery, and cross-instance room pub/sub",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluxstack/live": "^0.7.0"
  },
  "peerDependencies": {
    "ioredis": ">=5.0.0"
  },
  "devDependencies": {
    "ioredis": "^5.6.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FluxStackCore/fluxstack-live",
    "directory": "packages/redis"
  },
  "license": "MIT",
  "keywords": ["redis", "cluster", "pubsub", "realtime", "live-components", "fluxstack"],
  "engines": {
    "node": ">=18.0.0"
  }
}
