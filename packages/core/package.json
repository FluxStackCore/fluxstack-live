{
  "name": "@fluxstack/live",
  "version": "0.5.1",
  "description": "Real-time server-client state sync — LiveServer, LiveComponent, rooms, auth, security, and cluster coordination",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js",
      "require": "./dist/build/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "ioredis": "^5.10.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  },
  "keywords": [
    "live-components",
    "real-time",
    "websocket",
    "state-sync",
    "framework-agnostic"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FluxStackCore/fluxstack-live",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "FluxStack Team",
  "engines": {
    "node": ">=18.0.0"
  }
}
