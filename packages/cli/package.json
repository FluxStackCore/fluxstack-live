{
  "name": "@fluxstack/live-cli",
  "version": "0.9.0",
  "description": "CLI inspector & dev tools for @fluxstack/live — inspect WebSocket traffic, mount components, call actions, join rooms",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fluxstack-inspect": "./dist/inspector.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluxstack/live": "^0.9.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FluxStackCore/fluxstack-live",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "keywords": ["websocket", "inspector", "cli", "devtools", "realtime", "live-components", "fluxstack"],
  "engines": {
    "node": ">=18.0.0"
  }
}
